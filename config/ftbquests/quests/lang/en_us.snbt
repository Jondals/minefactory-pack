	quest.318970E38BB89BD5.quest_desc: [
		"Con FTB Teams podéis compartir el progreso del libro: lo que consiga uno cuenta para los dos."
		"Usa &e/ftbteams party create&r y luego invita con &e/ftbteams party invite <nombre>&r."
		""
		"Los cofres de las mazmorras (Lootr) tienen botín distinto para cada jugador: abridlos los dos."
	]
	quest.318970E38BB89BD5.title: "Jugar en pareja"
	quest.32A7FCBC35AEDEBA.quest_desc: [
		"Encima del yacimiento: la base abajo, la manivela con rotación y el martillo encima. Saca crudo sin parar."
