	quest.D32790713EAF0F0A.quest_desc: [
		"&6Cómo funciona Create:&r nada usa electricidad al principio, todo funciona con &erotación&r."
		"Una fuente (rueda de agua, molino de viento, motor) gira, y los ejes y engranajes llevan ese giro a las máquinas."
		""
		"Dos engranajes pequeños juntos giran al revés. Uno pequeño con uno grande cambia la velocidad (RPM)."
	]
	quest.D32790713EAF0F0A.title: "Ejes y engranajes"
	quest.D3B07DCC01CD49D1.quest_desc: [
		"Pon los controles, monta el tren y conduce. Marca la misión cuando lo hayas hecho."
	]
	quest.D3B07DCC01CD49D1.title: "Tu primer tren"
	quest.D4ECDFC520477F6D.quest_desc: [
		"Costa de tiza sobre el mar."
	]
	quest.D4ECDFC520477F6D.title: "Acantilados blancos"
	quest.D5587E1F6AA15AB8.quest_desc: [
		"Chipped: cientos de variantes de cada bloque."
		"Cada mesa (albañil, carpintero, tejedor…) trabaja con un tipo de bloque; el cincel lo hace desde la mano."
	]
	quest.D5587E1F6AA15AB8.title: "Variantes de bloques"
	quest.D8D387F848C5E1FD.quest_desc: [
		"Cada uno con un instrumento distinto y la misma canción: un concierto a dúo. Marca la misión cuando lo hagáis."
	]
