	]
	quest.F4B89F2BA9058F9E.title: "Molino"
	quest.F548BB8900DBE00E.quest_desc: [
		"Una torre hueca de ladrillo refractario con la salida abajo."
		"Échale hierro y coque por arriba y saldrá &eacero fundido&r. Mira la animación con &eW&r en JEI para ver la forma exacta."
	]
	quest.F548BB8900DBE00E.title: "Alto horno"
	quest.F5B24E19C908375A.quest_desc: [
		"&6Cómo funciona:&r abre el inventario y usa la lista de la derecha."
		"&eR&r sobre un objeto: cómo se fabrica. &eU&r: para qué sirve."
		"&eW&r sobre algo de Create: animación que explica la máquina."
		"En la barra de búsqueda, &e@create&r muestra solo los objetos de ese mod."
	]
	quest.F5B24E19C908375A.title: "Buscar recetas (JEI)"
	quest.FAA4A2A0BCCB4F57.quest_desc: [
		"Tu primera fuente de energía. Ponla con agua corriendo por un lado."
		""
		"&6Estrés (SU):&r cada fuente da una cantidad de SU y cada máquina gasta SU. Si gastas más de lo que generas, todo se para."
		"Solución: más fuentes en el mismo eje, o máquinas más despacio."
	]
	quest.FAA4A2A0BCCB4F57.title: "Energía del agua"
