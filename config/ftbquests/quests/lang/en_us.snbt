	quest.2C59F3A083339978.quest_desc: [
		"El biplano escarlata."
	]
	quest.2C59F3A083339978.title: "Man of Many Planes"
	quest.2CA54CD8BC57E22E.quest_desc: [
		"Corail Tombstone: al morir aparece una tumba con todas tus cosas. Ve a por ella y haz clic derecho; solo su dueño puede abrirla."
	]
	quest.2CA54CD8BC57E22E.title: "Si morís…"
	quest.2DC094D7CC130452.quest_desc: [
		"Construction Wands: mira la cara de un bloque y haz clic derecho para poner una capa entera con los bloques de tu inventario."
		"Tiene varios modos (fila, muro, área…). Mira en Opciones → Controles la tecla para cambiarlos."
	]
	quest.2DC094D7CC130452.title: "Varita de construcción"
	quest.2F6852C21758594D.quest_desc: [
