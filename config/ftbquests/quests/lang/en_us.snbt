	]
	quest.33726D4BA74E9F9F.title: "Venus y Mercurio"
	quest.33EA30888962019F.quest_desc: [
		"Sin él, en el espacio no se respira."
	]
	quest.33EA30888962019F.title: "Traje espacial"
